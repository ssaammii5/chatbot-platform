{
  "name": "chatbot-platform",
  "version": "0.0.1",
  "private": true,
  "description": "White-label multi-tenant AI chatbot platform",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "dev": "nx run-many -t serve --parallel=5",
    "dev:backend": "nx serve backend",
    "dev:worker": "nx serve worker",
    "dev:frontend": "nx serve frontend",
    "dev:widget": "nx serve widget",
    "build": "nx run-many -t build",
    "build:affected": "nx affected -t build",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "graph": "nx graph",
    "migrate": "nx run backend:db:migrate",
    "studio": "nx run backend:db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@nx/eslint": "^20.4.0",
    "@nx/js": "^20.4.0",
    "@nx/nest": "^20.4.0",
    "@nx/next": "^20.4.0",
    "@nx/vite": "^20.4.0",
    "@nx/workspace": "^20.4.0",
    "nx": "^20.4.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
