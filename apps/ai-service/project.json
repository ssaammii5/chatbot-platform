{
  "name": "ai-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ai-service",
  "tags": ["scope:ai-service", "language:python"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose up ai-service",
        "cwd": "../.."
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker compose build ai-service",
        "cwd": "../.."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check apps/ai-service/",
        "cwd": "../.."
      }
    }
  }
}
