{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "outDir": "./dist",
    "moduleResolution": "node",
    "paths": {
      "*": ["../backend/node_modules/*"]
    }
  },
  "include": ["./*.ts"],
  "exclude": ["node_modules"]
}
