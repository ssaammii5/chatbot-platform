# ==========================================
# Database Credentials
# ==========================================
DB_USER=acp_user
DB_PASSWORD=your_db_password_here
DB_NAME=chatbot_platform_db

# ==========================================
# Redis Credentials
# ==========================================
REDIS_PASSWORD=your_redis_password_here

# ==========================================
# Auth & Security (Backend)
# ==========================================
JWT_SECRET_KEY=your_jwt_secret_here_min_32_chars_use_openssl_rand_hex_32
OAUTH2_ISSUER=http://localhost:8080/realms/dev
OAUTH2_CLIENT_ID=chatbot-client
OAUTH2_CLIENT_SECRET=your_oauth2_client_secret_here

# ==========================================
# AI Service Configuration
# ==========================================
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_CHAT_MODEL=gpt-4o-mini
RAG_TOP_K=5
RAG_MAX_TOKENS=1024
# Internal API key shared between NestJS backend and FastAPI service (generate with: openssl rand -hex 32)
INTERNAL_API_KEY=your_internal_api_key_here

# ==========================================
# Rate Limiting & Usage
# ==========================================
RATE_LIMIT_GLOBAL_RPM=1000
RATE_LIMIT_TENANT_TOKENS_PER_MIN=50000
USAGE_METERING_ENABLED=true

# ==========================================
# Worker Configuration
# ==========================================
BULLMQ_CONCURRENCY=5

# ==========================================
# Admin Frontend & Observability
# ==========================================
TENANT_APP_NAME=ChatAdmin
PGADMIN_EMAIL=admin@platform.com
PGADMIN_PASSWORD=your_pgadmin_password_here

# ==========================================
# Other Integrations
# ==========================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
